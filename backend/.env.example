# Copy to .env (local) and .env.docker (compose). Never commit real secrets.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ardoise
DB_PASSWORD=ardoise
DB_NAME=ardoise

DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared instance password. Leave empty for local dev (auth disabled).
# Set to a long random string in production to gate sync behind a password.
API_KEY=

BACKEND_CORS_ORIGINS=http://localhost:3060,http://localhost:8065
